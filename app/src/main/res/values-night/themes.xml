<!-- res/values-night/themes.xml -->
<resources>
    <!-- Единая дневная/ночная тема Material 3 без ActionBar -->
    <style name="Theme.NotificationArchiver" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Все цвета предоставляются автоматически:
             baseline Material3 + динамические цвета системы -->

        <!-- Edge-to-edge: прозрачные системные бары -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Автоматическое определение светлого/тёмного статус-бара
             в зависимости от текущей темы -->
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
    </style>
</resources>